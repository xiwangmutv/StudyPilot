# Copy this file to .env.local and paste your provider key there.
# Never commit .env.local or expose its values to browser code.
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat

# Public Google Form URL used by the Feedback page.
GOOGLE_FEEDBACK_FORM_URL=
