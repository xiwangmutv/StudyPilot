# AI provider (used by /api/next-action)
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=replace_with_your_ai_provider_key
AI_MODEL=deepseek-chat

# Feedback email delivery (used by /api/feedback)
RESEND_API_KEY=replace_with_your_resend_api_key
FEEDBACK_FROM_EMAIL="FirstPilot Feedback <feedback@your-verified-domain.com>"
FEEDBACK_TO_EMAIL=your-team-inbox@example.com
