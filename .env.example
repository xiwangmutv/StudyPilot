AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
# Copy this file to .env.local, then paste your own key after the equals sign.
# Never put a real key in this example file or commit .env.local.
AI_API_KEY=
AI_MODEL=deepseek-chat

# Feedback delivery via Resend. Use a verified Resend sender address.
RESEND_API_KEY=
FEEDBACK_FROM_EMAIL="FirstPilot Feedback <feedback@your-domain.com>"
FEEDBACK_TO_EMAIL=
