# AI provider (used by /api/next-action)
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=replace_with_your_ai_provider_key
AI_MODEL=deepseek-chat

# Feedback form (used by /api/feedback)
# Paste the public Google Form URL. This is safe to expose, but remains
# server-side so the frontend can later keep using the same API route.
GOOGLE_FEEDBACK_FORM_URL=https://docs.google.com/forms/d/e/your-form-id/viewform

# Optional Google sign-in. Visitors can use FirstPilot without these values.
AUTH_SECRET=generate_a_long_random_value
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
